# ============================================================================
# FundFlow Sentinel — Environment Configuration
# ============================================================================

# HTTP Server Port
PORT=8501

# Application Data Mode: offline_snapshot | live | synthetic
FUNDFLOW_DATA_MODE=offline_snapshot

# Path to Data Root or Fixtures (default: data/snapshots)
FUNDFLOW_FIXTURE_DIR=data/snapshots

# Logging Verbosity: DEBUG | INFO | WARNING | ERROR
FUNDFLOW_LOG_LEVEL=INFO

# Streamlit Security & Performance Flags
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=true
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
